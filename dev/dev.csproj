<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <ScssFiles Include="Pages\**\*.cshtml.scss" />
    </ItemGroup>

    <Target Name="CompileScss"
            BeforeTargets="Build"
            Inputs="@(ScssFiles)"
            Outputs="@(ScssFiles->'%(RelativeDir)%(Filename).css')">
        <Message Text="Kompiluji SCSS soubory..." Importance="high" />
        <Exec Command="npx sass --no-source-map &quot;%(ScssFiles.Identity)&quot; &quot;%(ScssFiles.RelativeDir)%(ScssFiles.Filename).css&quot;" />
    </Target>
</Project>
